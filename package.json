{
  "name": "getvect",
  "version": "0.1.0",
  "private": true,
  "description": "Local, offline desktop raster-to-vector app \u2014 PNG/JPEG/BMP to SVG/EPS/DXF/PDF/PNG. No account, no credits, no upload.",
  "keywords": [
    "vectorize",
    "vectorizer",
    "raster-to-vector",
    "image-tracing",
    "svg",
    "eps",
    "dxf",
    "electron",
    "offline",
    "desktop-app"
  ],
  "homepage": "https://github.com/craigjmidwinter/getvect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craigjmidwinter/getvect.git"
  },
  "bugs": {
    "url": "https://github.com/craigjmidwinter/getvect/issues"
  },
  "author": "Craig Midwinter (https://craigmidwinter.com)",
  "license": "MIT",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && xattr -cr node_modules/electron/dist/Electron.app || true",
    "clean": "node scripts/clean.mjs",
    "build:node": "tsc -p tsconfig.node.json && node scripts/bundle-updater.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:node && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "assets": "npm run build:node && node scripts/regenerate-derived-assets.mjs",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "pretest:engine": "npm run build:node",
    "test:engine": "node --test tests/engine/*.test.mjs",
    "test:headed": "playwright test --headed",
    "instruments": "npm run build:node && node instruments/run-instruments.mjs",
    "instruments:selftest": "node instruments/run-instruments.mjs --engine=instruments/reference-engine.mjs --out=artifacts/metrics-selftest.json --tag=selftest",
    "screenshots": "npm run build && node instruments/run-screenshots.mjs",
    "docs:screenshots": "npm run build && node scripts/docs-screenshots.mjs",
    "dist": "electron-builder",
    "devlog:audit": "node scripts/devlog-gate.mjs --audit",
    "devlog:build": "node scripts/devlog-gate.mjs --build"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.9",
    "imagetracerjs": "^1.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  }
}
